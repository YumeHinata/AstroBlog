<div
    id="comments-container"
    class="card-base z-10 px-6 md:px-9 pt-6 pb-4 relative w-full"
>
    <script
        src="https://giscus.app/client.js"
        data-repo="YumeHinata/Giscus_Discussions"
        data-repo-id="R_kgDORLYjgQ"
        data-category="Announcements"
        data-category-id="DIC_kwDORLYjgc4C2C7H"
        data-mapping="pathname"
        data-strict="0"
        data-reactions-enabled="1"
        data-emit-metadata="0"
        data-input-position="top"
        data-theme="dark"
        data-lang="zh-CN"
        data-loading="lazy"
        crossorigin="anonymous"
        async></script>
</div>

<script is:inline>
  // 监听Giscus生成的元素并添加额外的类
  const observer = new MutationObserver(function(mutationsList) {
    for (let mutation of mutationsList) {
      for (let node of mutation.addedNodes) {
        // 只检查节点本身是否包含gsc-comments类，不影响子元素
        if (node.classList && node.classList.contains('gsc-comments') && !node.classList.contains('relative')) {
          // 添加所需的类
          node.classList.add('relative', 'transition', 'overflow-hidden', 
                            'bg-[var(--license-block-bg)]', 'py-5', 'px-6', 
                            'mb-6', 'rounded-xl', 'onload-animation');
          return;
        }
      }
    }
  });

  // 开始观察整个文档的变化
  observer.observe(document.body, { childList: true, subtree: true });
</script>