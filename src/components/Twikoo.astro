<div
    id="comments-container"
    class="flex card-base z-10 px-6 md:px-9 pt-6 pb-4 relative w-full mt-4"
></div>

<script is:inline data-astro-rerun>
    async function initTwikoo() {
        const container = document.getElementById("comments-container");

        if (!container) return;

        if (container.dataset.twikooInitialized === "true") return;

        if (typeof twikoo === "undefined") {
            await new Promise((resolve, reject) => {
                const existing = document.getElementById("twikoo-script");

                if (existing) {
                    existing.addEventListener("load", resolve, { once: true });
                    existing.addEventListener("error", reject, { once: true });
                    return;
                }

                const script = document.createElement("script");
                script.id = "twikoo-script";
                script.src =
                    "https://fastly.jsdelivr.net/npm/twikoo@2.0.12/dist/twikoo.min.js";

                script.onload = resolve;
                script.onerror = reject;

                document.head.appendChild(script);
            });
        }

        if (typeof twikoo === "undefined") {
            console.error("Twikoo 加载失败");
            return;
        }

        container.dataset.twikooInitialized = "true";

        try {
            await twikoo.init({
                envId: "https://twikoo.yumehinata.com/",
                el: "#comments-container",
                lang: "zh-CN",
            });
        } catch (error) {
            container.dataset.twikooInitialized = "false";
            console.error("Twikoo 初始化失败:", error);
        }
    }

    initTwikoo();
</script>