<div
    id="comments-container"
    class="flex card-base z-10 px-6 md:px-9 pt-6 pb-4 relative w-full mt-4"
>
</div>
<script src="https://fastly.jsdelivr.net/npm/twikoo@2.0.12/dist/twikoo.min.js"
></script>
<script>
    twikoo.init({
        envId: "https://twikoo.yumehinata.com/", // 腾讯云环境填 envId；Vercel 环境填地址（https://xxx.vercel.app）
        el: "comments-container", // 容器元素
        lang: "zh-CN", // 用于手动设定评论区语言，支持的语言列表 https://github.com/twikoojs/twikoo/blob/main/packages/client/src/i18n/index.ts
    });
</script>
